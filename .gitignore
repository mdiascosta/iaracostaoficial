# Arquivos que não devem entrar no Git

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/
.idea/
*.swp
*~

# Dependências do teste do Bloco A: o npm cria esta pasta a partir do
# package.json. Fica fora do Git porque são milhares de arquivos de terceiros.
node_modules/
package-lock.json

# Python
__pycache__/
*.pyc
.venv/

# Arquivos temporários de exportação do WordPress / Elementor
# (não confundir com os JSONs do Bloco B, que são entregáveis e vão versionados)
*.tmp
*-backup-*.json
updraft/
wp-content/uploads/

# Logs
*.log
preview/
